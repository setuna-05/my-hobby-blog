---
import Layout from '../layouts/Layout.astro';
---

<Layout title="About" description="About Me">

  <div class="wireframe-area">
   <div class="wireframe-box box-profile">
  <span class="box-badge">me</span>
  <div class="profile-header">
    <div class="profile-avatar">
      <img src="/images/icon.jpg" alt="アイコン" />
    </div>
    <p class="profile-name">雪梛</p>
  </div>
  <p class="profile-tagline">無価値な私と価値ある子たち</p>
</div>
<div class="wireframe-box box-sns">
  <span class="box-badge">SNS</span>
  <div class="sns-links">
    <a href="https://www.nicovideo.jp/user/142063184" target="_blank" class="sns-link">
      <span class="sns-name">ニコニコ動画</span>
    </a>
    <a href="https://kakuyomu.jp/users/setuna_kasumi" target="_blank" class="sns-link">
      <span class="sns-name">カクヨム</span>
    </a>
  </div>
</div>
</div>
</Layout>

<style>
  h1 {
    font-family: 'M PLUS Rounded 1c', sans-serif;
    font-weight: 800;
    background: linear-gradient(135deg, #ff8fab, #ffb56b);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    font-size: 2.6rem;
    margin-bottom: 2.5rem;
  }

  .wireframe-area {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 4rem;
  position: relative;
  left: -25rem;
  margin-top: 5.65rem;
}

  .wireframe-box {
  position: relative;
  color: var(--color-text);
  padding: 1.2rem;
  box-sizing: border-box;
  text-align: left;
  border-radius: 20px;
  background: transparent;
}

.wireframe-box::before {
  content: '';
  position: absolute;
  inset: 0;
  border-radius: 20px;
  background: var(--color-surface);
  border: 3px solid transparent;
  box-shadow: var(--shadow-soft);
  z-index: -1;
}

.wireframe-box {
  position: relative;
  color: var(--color-text);
  padding: 1.2rem;
  box-sizing: border-box;
  text-align: left;
  border-radius: 20px;
  background: transparent;
  display: flex;
  flex-direction: column;
}

.wireframe-box p {
  margin: 0 0 0.4rem 0;
  font-size: 1.1rem;
}

.box-profile {
  width: 360px;
  height: 232px;
}

.box-profile::before {
  inset: -6px -3px -4px -5px;
  border-color: #6b83c9;
  transform: rotate(-1deg);
}

.profile-header {
  display: flex;
  align-items: center;
  gap: 4rem;
  margin-bottom: 0.8rem;
}

.profile-avatar {
  width: 120px;
  height: 120px;
  border-radius: 50%;
  overflow: hidden;
  box-shadow: 0 0 16px rgba(255, 143, 171, 0.25);
  margin-bottom: 0;
  flex-shrink: 0;
}

.profile-avatar img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.profile-header .profile-name {
  font-family: 'M PLUS Rounded 1c', sans-serif;
  font-weight: 700;
  font-size: 2.5rem;
  margin: 0;
}

.box-profile .profile-tagline {
  font-family: 'Yomogi', sans-serif;
  color: #b98fd9;
  font-size: 1.5rem;
}


.box-sns {
  width: 520px;
  height: 280px;
}

.box-sns::before {
  inset: 3px 6px 5px 3px;
  border-color: #6bc98a;
  transform: rotate(1deg);
}

.box-badge {
  position: absolute;
  top: -35px;
  left: -35px;
  min-width: 100px;
  height: 50px;
  padding: 1rem;
  border-radius: 999px;
  font-family: 'Yomogi', sans-serif;
  font-weight: 800;
  font-size: 2.5rem;
 color: #b98fd9;
  background: var(--color-surface);
  box-shadow: var(--shadow-soft), 0 4px 10px rgba(0, 0, 0, 0.3);
  z-index: 2;
  transform: rotate(-15deg);
  margin: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.box-profile .box-badge {
  border: 2px solid #6b83c9;
}

.box-sns .box-badge {
  border: 2px solid #6bc98a;
}

.sns-links {
  display: flex;
  flex-direction: column;
  gap: 0.8rem;
  margin-top: 0.5rem;
}

.sns-link {
  display: inline-block;
  text-decoration: none;
  color: var(--color-text);
  font-size: 1.1rem;
  font-weight: 600;
  padding: 0.6rem 0;
  border-bottom: 2px solid transparent;
  transition: color 0.2s ease, border-color 0.2s ease;
  transform: rotate(1deg);
}

.sns-link:hover {
  color: #ffb98f;
  border-color: #ffb98f;
}

  @media (max-width: 768px) {
    h1 {
      font-size: 1.9rem;
    }

    .box-profile,
    .box-sns {
      width: 100%;
      height: auto;
      min-height: 200px;
    }
  }
</style>