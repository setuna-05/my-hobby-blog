---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

const categoryLabels: Record<string, string> = {
  outdoor: 'アウトドア',
  writing: '執筆',
  Maya: 'Maya',
  other: 'その他',
};

const allPosts = await getCollection('blog', ({ data }) => {
  return data.draft !== true;
});
allPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<Layout title="記事一覧">
  <h1>記事一覧</h1>

  {allPosts.length === 0 ? (
    <p class="no-posts">まだ記事がありません</p>
  ) : (
    <ul class="post-list">
      {allPosts.map((post) => (
        <li>
          <a href={`/blog/${post.id}/`}>
            <span class={`category-tag ${post.data.category}`}>
              {categoryLabels[post.data.category]}
            </span>
            <span class="post-title">{post.data.title}</span>
          </a>
          <span class="date">
            {post.data.pubDate.toLocaleDateString('ja-JP')}
          </span>
        </li>
      ))}
    </ul>
  )}
</Layout>

<style>
  h1 {
    font-family: 'M PLUS Rounded 1c', sans-serif;
    font-weight: 800;
    background: linear-gradient(135deg, #ff8fab, #ffb56b);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    font-size: 2.6rem;
    margin-bottom: 2rem;
  }

  .post-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .post-list li {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1rem 1.2rem;
    margin-bottom: 0.6rem;
    background: var(--color-surface);
    border-radius: 16px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.25);
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }

  .post-list li:hover {
    transform: translateX(4px);
    box-shadow: var(--shadow-soft);
  }

  .post-list li a {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    text-decoration: none;
    flex: 1;
    min-width: 0;
  }

  .category-tag {
    flex-shrink: 0;
    padding: 0.3rem 0.8rem;
    border-radius: 999px;
    font-size: 0.75rem;
    font-weight: 700;
    font-family: 'M PLUS Rounded 1c', sans-serif;
  }

  .category-tag.outdoor {
    background: #2e3a5c;
    color: #9db8ff;
  }
  .category-tag.writing {
    background: #2c4535;
    color: #8fe0a8;
  }
  .category-tag.Maya {
    background: #33184d;
    color: #9900ff;
  }
  .category-tag.other {
    background: #4a3524;
    color: #ffb877;
  }
  

  .post-title {
    color: var(--color-text);
    font-weight: 600;
    transition: color 0.2s ease, text-shadow 0.2s ease;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .post-list li:hover .post-title {
    color: #e8b98a;
    text-shadow: 0 0 4px rgba(232, 185, 138, 0.35);
  }

  .date {
  flex-shrink: 0;
  color: #9db8ff;
  font-size: 1.1rem;
  font-weight: 800;
  font-family: 'M PLUS Rounded 1c', sans-serif;
  margin-left: 1rem;
  letter-spacing: 0.02em;
}

  .no-posts {
    color: var(--color-text-muted);
    font-style: italic;
  }

  @media (max-width: 768px) {
    h1 {
      font-size: 1.9rem;
    }

    .post-list li {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.5rem;
      padding: 0.9rem 1rem;
    }

    .post-list li a {
      width: 100%;
    }

    .date {
      margin-left: 0;
    }
  }
</style>