---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MoonWidget from '../components/MoonWidget.astro';
import RainDeco from '../components/RainDeco.astro';

interface Props {
	title: string;
	description?: string;
}

const { title, description = '' } = Astro.props;
const isHomePage = Astro.url.pathname === '/';
---

<html lang="ja">
	<head>
		<BaseHead title={title} description={description} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=M+PLUS+Rounded+1c:wght@400;500;700;800&family=Zen+Maru+Gothic:wght@400;500;700&family=Yomogi&display=swap"
			rel="stylesheet"
		/>
	</head>
	<body>
		<MoonWidget />
		{isHomePage && <RainDeco />}

		<Header />
		<main>
			<slot />
		</main>
		<Footer />
	</body>
</html>

<style is:global>
	:root {
		--color-bg: #2a2233;
		--color-surface: #3a3042;
		--color-accent: #ff8fab;
		--color-accent-soft: #4a3f52;
		--color-text: #b8ada3;
		--color-text-muted: #9a8d81;
		--shadow-soft: 0 4px 16px rgba(255, 143, 171, 0.15);
	}

	body {
		background-color: var(--color-bg);
		background-image:
			radial-gradient(3.5px 3.5px at 20px 30px, rgba(255,255,255,0.6), transparent),
			radial-gradient(3.5px 3.5px at 140px 80px, rgba(255,255,255,0.5), transparent),
			radial-gradient(3px 3px at 90px 150px, rgba(255,255,255,0.7), transparent),
			radial-gradient(3.5px 3.5px at 250px 60px, rgba(255,255,255,0.4), transparent),
			radial-gradient(2.5px 2.5px at 320px 200px, rgba(255,255,255,0.6), transparent),
			radial-gradient(3px 3px at 60px 250px, rgba(255,255,255,0.5), transparent),
			radial-gradient(3.5px 3.5px at 380px 120px, rgba(255,255,255,0.5), transparent),
			radial-gradient(2.5px 2.5px at 200px 300px, rgba(255,255,255,0.6), transparent),
			radial-gradient(3px 3px at 45px 100px, rgba(255,255,255,0.5), transparent),
			radial-gradient(2.5px 2.5px at 170px 220px, rgba(255,255,255,0.6), transparent),
			radial-gradient(3px 3px at 300px 30px, rgba(255,255,255,0.5), transparent),
			radial-gradient(2.5px 2.5px at 350px 280px, rgba(255,255,255,0.55), transparent);
		background-repeat: repeat;
		background-size: 400px 400px;
		color: var(--color-text);
		font-family: 'Zen Maru Gothic', sans-serif;
		margin: 0;
		position: relative;
	}

	main {
		max-width: 800px;
		margin: 0 auto;
		padding: 2rem 1.5rem;
	}

	a {
		color: var(--color-text);
	}

	@media (max-width: 768px) {
		main {
			padding: 1rem 1rem;
		}
	}
</style>