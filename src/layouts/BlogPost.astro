---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, pubDate, updatedDate, thumbnail, category } = Astro.props;
---

<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
		<style>
	.hero-image {
		width: 100%;
		height: 400px;
		overflow: hidden;
		border-radius: 12px;
		background: var(--color-bg);
	}
	.hero-image img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: contain;
		margin: 0 auto;
		box-shadow: var(--box-shadow);
	}
	.prose {
		width: 720px;
		max-width: calc(100% - 2em);
		margin: auto;
		padding: 1em;
		color: rgb(var(--gray-dark));
	}
	.prose :global(h3) {
		display: inline-block;
		padding-bottom: 0.3rem;
		border-bottom: 4px solid #ffb56b;
		border-radius: 2px;
		margin-top: 2rem;
	}
	.title {
		margin-bottom: 1em;
		padding: 1em 0;
		text-align: center;
		line-height: 1;
	}
	.title h1 {
		margin: 0 0 0.5em 0;
	}
	.date {
		margin-bottom: 0.5em;
		color: rgb(var(--gray));
	}
	.last-updated-on {
		font-style: italic;
	}

	.prose :global(img) {
	border-radius: 14px;
	border: 3px solid #b98fd9;
	box-shadow: var(--shadow-soft);
	transition: transform 0.2s ease, box-shadow 0.2s ease;
	position: relative;
}

	.prose :global(img:hover) {
		transform: translateY(-4px) scale(1.01);
		box-shadow: var(--shadow-soft), 0 8px 20px rgba(0, 0, 0, 0.3);
	}

	.prose :global(.img-comment-wrapper) {
		position: relative;
		display: block;
	}

	.prose :global(.img-comment) {
	position: absolute;
	bottom: 12px;
	left: 12px;
	right: 12px;
	background: var(--color-surface);
	color: #01eeff;
	text-shadow:
		-1px -1px 0 #000,
		1px -1px 0 #000,
		-1px 1px 0 #000,
		1px 1px 0 #000,
		0 0 6px rgba(1, 238, 255, 0.6),
		1px 1px 1px rgba(0, 0, 0, 0.6);
	padding: 0.6rem 1rem;
	border-radius: 12px;
	font-size: 0.9rem;
	box-shadow: var(--shadow-soft);
	opacity: 0;
	transform: translateY(8px);
	pointer-events: none;
	transition: opacity 0.25s ease, transform 0.25s ease;
}

	.prose :global(.img-comment-wrapper:hover .img-comment) {
		opacity: 1;
		transform: translateY(0);
	}

	@media (max-width: 768px) {
		main {
			padding: 1rem 1rem;
		}

		.moon-deco {
			top: 130px;
			right: 20px;
			font-size: 1.6rem;
		}

		.moon-deco.moon-moved {
			right: calc(100% - 50px);
		}

		.moon-menu {
			top: 175px;
			right: 20px;
			padding: 0.6rem;
		}

		.moon-deco.moon-moved ~ .moon-menu {
			right: calc(100% - 50px);
		}
	}
</style>
	</head>

	<body>
		<Header />
		<main>
			<article>
				<div class="hero-image">
	{thumbnail && <img src={thumbnail} alt="" />}
</div>
				<div class="prose">
					<div class="title">
						<div class="date">
							<FormattedDate date={pubDate} />
							{
								updatedDate && (
									<div class="last-updated-on">
										Last updated on <FormattedDate date={updatedDate} />
									</div>
								)
							}
						</div>
						<h1>{title}</h1>
						{category && (
  <span class="category-badge">
    {category}
  </span>
)}
						<hr />
					</div>
					<slot />
				</div>
			</article>
		</main>
		<Footer />
	</body>

	<script>
		document.querySelectorAll('.prose img[title]').forEach((img) => {
			const comment = img.getAttribute('title');
			img.removeAttribute('title');

			const wrapper = document.createElement('span');
			wrapper.className = 'img-comment-wrapper';
			img.parentNode?.insertBefore(wrapper, img);
			wrapper.appendChild(img);

			const bubble = document.createElement('div');
			bubble.className = 'img-comment';
			bubble.textContent = comment;
			wrapper.appendChild(bubble);
		});
	</script>
</html>